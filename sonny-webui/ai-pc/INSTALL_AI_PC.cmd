@echo off
setlocal EnableExtensions

echo ============================================================
echo  SONNY - AI PC SETUP (Main AI + Open WebUI + AI-PC Control)
echo ============================================================
echo  Role: Hosts Open WebUI (127.0.0.1:3000), existing Ollama
echo        (11434), and AI-PC Open Terminal (127.0.0.1:8001).
echo ============================================================
echo.

set "KIT_AI_DIR=%~dp0"
if "%KIT_AI_DIR:~-1%"=="\" set "KIT_AI_DIR=%KIT_AI_DIR:~0,-1%"
set "AGENT_DIR=C:\SonnyAgent"
set "VENV_DIR=%AGENT_DIR%\venv"
set "CONFIG_DST=%AGENT_DIR%\ai-pc.toml"
set "TASK_NAME=SonnyTerminal_AIPC"

REM 1. Require local secrets generated by init_config.py first.
if not exist "%KIT_AI_DIR%\.env" (
    echo [ERROR] Missing %KIT_AI_DIR%\.env
    echo         Run init_config.py first to generate private local keys.
    exit /b 1
)
if not exist "%KIT_AI_DIR%\ai-pc.toml" (
    echo [ERROR] Missing %KIT_AI_DIR%\ai-pc.toml
    echo         Run init_config.py first to generate private local keys.
    exit /b 1
)

REM 2. Verify Python 3.11+ is available.
where python >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Python 3.11+ was not found on PATH.
    exit /b 1
)
python -c "import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)"
if errorlevel 1 (
    echo [ERROR] Python 3.11 or newer is required.
    python --version
    exit /b 1
)
echo [OK] Python 3.11+ verified.

REM 3. Verify Docker is running (never starts/stops other containers).
docker info >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Docker is not running. Start Docker Desktop, then rerun.
    exit /b 1
)
echo [OK] Docker is running.

REM 4. Verify existing Ollama is reachable on 127.0.0.1:11434 (read-only; never pulls/deletes models).
python -c "import json, urllib.request; d = json.loads(urllib.request.urlopen('http://127.0.0.1:11434/api/tags', timeout=5).read()); names = [m.get('name','') for m in d.get('models',[])]; print('[OK] Ollama reachable - installed models:', ', '.join(names) if names else '(none)')"
if errorlevel 1 (
    echo [ERROR] Ollama did not answer on http://127.0.0.1:11434. Confirm Ollama is running, then rerun.
    exit /b 1
)

REM 5. Verify Tailscale is running (read-only; never changes Tailscale state).
tailscale status >nul 2>&1
if errorlevel 1 (
    echo [WARN] Tailscale CLI did not report connected yet. Local setup will continue.
) else (
    echo [OK] Tailscale is connected.
)

REM 6. Create isolated C:\SonnyAgent\venv and install open-terminal.
if not exist "%AGENT_DIR%\logs\ai-pc" mkdir "%AGENT_DIR%\logs\ai-pc"
if not exist "%VENV_DIR%\Scripts\python.exe" (
    echo [STEP] Creating isolated Python venv at %VENV_DIR% ...
    python -m venv "%VENV_DIR%"
    if errorlevel 1 (
        echo [ERROR] Failed to create venv at %VENV_DIR%.
        exit /b 1
    )
)
echo [STEP] Installing/verifying open-terminal in isolated venv ...
"%VENV_DIR%\Scripts\python.exe" -m pip install --upgrade --disable-pip-version-check open-terminal
if errorlevel 1 (
    echo [ERROR] Failed to install open-terminal.
    exit /b 1
)
if not exist "%VENV_DIR%\Scripts\open-terminal.exe" (
    echo [ERROR] open-terminal.exe missing after install.
    exit /b 1
)
echo [OK] open-terminal installed in isolated venv.

REM 7. Copy ai-pc.toml and helper scripts, then restrict ai-pc.toml ACL to current user only.
copy /Y "%KIT_AI_DIR%\ai-pc.toml" "%CONFIG_DST%" >nul
if errorlevel 1 (
    echo [ERROR] Failed to copy ai-pc.toml to %CONFIG_DST%.
    exit /b 1
)
icacls "%CONFIG_DST%" /inheritance:r /grant:r "%USERDOMAIN%\%USERNAME%:(R,W)" >nul
copy /Y "%KIT_AI_DIR%\START_AI_PC_TERMINAL.cmd" "%AGENT_DIR%\START_AI_PC_TERMINAL.cmd" >nul
copy /Y "%KIT_AI_DIR%\STOP_AI_PC_TERMINAL.cmd" "%AGENT_DIR%\STOP_AI_PC_TERMINAL.cmd" >nul
echo [OK] AI-PC config installed and locked to %USERNAME%.

REM 8. Register logon Scheduled Task and start AI-PC Open Terminal on 127.0.0.1:8001.
schtasks /Create /F /TN "%TASK_NAME%" /SC ONLOGON /RL LIMITED /TR "\"%VENV_DIR%\Scripts\open-terminal.exe\" run --isolated --config \"%CONFIG_DST%\"" >nul
if errorlevel 1 (
    echo [ERROR] Failed to create Scheduled Task %TASK_NAME%.
    exit /b 1
)
schtasks /Run /TN "%TASK_NAME%" >nul
echo [STEP] Waiting for AI-PC Open Terminal on http://127.0.0.1:8001/health ...
python -c "import sys,time,urllib.request as u; exec('for _ in range(int(sys.argv[2])):\n try:\n  if u.urlopen(sys.argv[1],timeout=2).status==200: sys.exit(0)\n except Exception: time.sleep(1)\nsys.exit(1)')" "http://127.0.0.1:8001/health" 15
if errorlevel 1 (
    echo [ERROR] AI-PC Open Terminal did not answer on http://127.0.0.1:8001/health.
    echo         Check logs in %AGENT_DIR%\logs\ai-pc
    exit /b 1
)
echo [OK] AI-PC Open Terminal is live on 127.0.0.1:8001.

REM 9. Start Open WebUI container ("sonny-webui") on 127.0.0.1:3000.
echo [STEP] Starting Open WebUI (sonny-webui) on http://127.0.0.1:3000 ...
docker compose --project-directory "%KIT_AI_DIR%" -f "%KIT_AI_DIR%\compose.yaml" up -d
if errorlevel 1 (
    echo [ERROR] docker compose up failed.
    exit /b 1
)

echo [STEP] Waiting for Open WebUI health check (first pull/boot takes 20-60s) ...
python -c "import sys,time,urllib.request as u; exec('for _ in range(int(sys.argv[2])):\n try:\n  if u.urlopen(sys.argv[1],timeout=3).status==200: sys.exit(0)\n except Exception: time.sleep(2)\nsys.exit(1)')" "http://127.0.0.1:3000/health" 45
if errorlevel 1 (
    echo [ERROR] Open WebUI did not become healthy within 90s. Run: docker logs sonny-webui --tail 50
    exit /b 1
)
echo [OK] Sonny Open WebUI is live on http://127.0.0.1:3000

REM 10. Verify container can reach host Ollama and AI-PC Open Terminal.
docker exec sonny-webui python3 -c "import urllib.request; urllib.request.urlopen('http://host.docker.internal:11434/api/version', timeout=4)" >nul 2>&1
if errorlevel 1 (
    echo [WARN] Container could not reach host.docker.internal:11434 - check Windows Firewall / Ollama bind.
) else (
    echo [OK] Container connected to AI-PC Ollama ^(11434^).
)
docker exec sonny-webui python3 -c "import urllib.request; urllib.request.urlopen('http://host.docker.internal:8001/health', timeout=4)" >nul 2>&1
if errorlevel 1 (
    echo [WARN] Container could not reach host.docker.internal:8001 - check Windows Firewall for Docker subnet.
) else (
    echo [OK] Container connected to AI-PC Open Terminal ^(8001^).
)

echo.
echo ============================================================
echo  [DONE] AI PC READY
echo  1. Open http://127.0.0.1:3000 and create your owner login.
echo  2. Run: python scripts\configure_webui.py
echo ============================================================
exit /b 0
